# Maintainer: DiShus contributors
pkgname=dishus-git
_pkgname=dishus
pkgver=0.1.0
pkgrel=1
pkgdesc="Control this Linux PC from your Android phone, peer-to-peer over iroh (daemon + CLI)"
arch=('x86_64' 'aarch64')
url="https://github.com/dishus/dishus"
license=('MIT OR Apache-2.0')
depends=(
  'gcc-libs' 'glibc'
  'gstreamer'                # coreelements
  'gst-plugins-base-libs'    # appsink, videoconvertscale, videorate, videotestsrc
  'gst-plugin-pipewire'      # pipewiresrc
  'gst-plugins-bad-libs'     # nvcodec (NVENC, cudascale), h264parse
  'pipewire' 'xdg-desktop-portal'
)
optdepends=(
  'nvidia-utils: NVENC hardware encoding'
  'gst-plugin-va: VA-API hardware encoding (Intel/AMD)'
  'libva-mesa-driver: VA-API driver for AMD'
  'intel-media-driver: VA-API driver for Intel'
  'gst-plugins-ugly: x264 software encoder fallback'
  'gst-plugins-bad: openh264 software encoder fallback'
  'gst-plugins-good: X11 capture fallback (ximagesrc)'
  'xdg-desktop-portal-hyprland: screen capture on Hyprland'
  'xdg-desktop-portal-gnome: screen capture on GNOME and niri'
  'xdg-desktop-portal-kde: screen capture on KDE Plasma'
)
makedepends=('cargo' 'git')
provides=('dishus')
conflicts=('dishus')
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')
options=('!lto')

pkgver() {
  cd "$_pkgname"
  printf "0.1.0.r%s.g%s" "$(git rev-list --count HEAD)" "$(git rev-parse --short HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable CARGO_TARGET_DIR=target
  cargo build --frozen --release -p dishus-daemon -p dishus-cli
}

check() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo test --frozen --release -p dishus-proto -p dishus-daemon
}

package() {
  cd "$_pkgname"
  install -Dm755 target/release/dishus-daemon "$pkgdir/usr/bin/dishus-daemon"
  install -Dm755 target/release/dishus "$pkgdir/usr/bin/dishus"
  install -Dm644 packaging/systemd/dishus.service "$pkgdir/usr/lib/systemd/user/dishus.service"
  install -Dm644 packaging/udev/70-dishus-uinput.rules "$pkgdir/usr/share/dishus/70-dishus-uinput.rules"
  install -Dm644 README.md "$pkgdir/usr/share/doc/dishus/README.md"
  install -Dm644 docs/SECURITY.md "$pkgdir/usr/share/doc/dishus/SECURITY.md"
  install -Dm644 LICENSE-MIT "$pkgdir/usr/share/licenses/$pkgname/LICENSE-MIT"
  install -Dm644 LICENSE-APACHE "$pkgdir/usr/share/licenses/$pkgname/LICENSE-APACHE"
}
